{
  "expo": {
    "name": "Barber Shop",
    "slug": "souqalhalaqeen",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/1024x1024.png",
    "scheme": "barbersshop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rawadag.barbersshop",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Access to your photos is needed to upload payment receipts and product images.",
        "LSApplicationQueriesSchemes": [
          "shamcash"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "splash": {
      "image": "./assets/300x300.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/1024x1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rawadag.barbersshop",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "expo.dev",
              "pathPrefix": "/accounts/souqalhalaqeen-organaization/projects/souqalhalaqeen"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "souqalhlaqyn.duckdns.org"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "ios": {
            "image": "./assets/300x300.png",
            "imageWidth": 300
          },
          "android": {
            "image": "./assets/300x300.png",
            "imageWidth": 300
          }
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {},
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "./plugins/withLocalizedAppLabel.js",
        {
          "ar": "سوق الحلاقين"
        }
      ],
      "expo-video",
      "./plugins/withApkInstaller.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28c84613-b6ec-42c0-bff2-cc774b86f0aa"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/28c84613-b6ec-42c0-bff2-cc774b86f0aa",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkOnLaunch": "ALWAYS"
    },
    "runtimeVersion": "1.0.0",
    "owner": "souqalhalaqeen-organaization",
    "developmentClient": {
      "silentLaunch": false,
      "android": {
        "package": "com.rawadag.barbersshop.debug"
      },
      "ios": {
        "bundleIdentifier": "com.rawadag.barbersshop.debug"
      }
    }
  }
}
