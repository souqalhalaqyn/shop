{
  "expo": {
    "name": "Barber Shop",
    "slug": "barbers-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "barbersshop",
    "userInterfaceStyle": "automatic",

    "ios": {},
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rawadag.barbersshop"
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "android": {
            "image": "./assets/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      ["expo-build-properties", {
        "android": {
          "usesCleartextTraffic": true
        }
      }],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2aa8868-82fc-4c29-8cf2-f283a7b34a35"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c2aa8868-82fc-4c29-8cf2-f283a7b34a35",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "rawad-ag"
  }
}
